    "axios": "1.19.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "element-plus": "2.14.3",
    "file-saver": "2.0.5",
    "fuse.js": "7.1.0",
    "js-beautify": "1.15.4",
